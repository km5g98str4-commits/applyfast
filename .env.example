# ApplyFast — Environment Variables
# Copy this to .env.local and fill in the values

# DeepSeek AI
DEEPSEEK_API_KEY=

# Upstash Redis (https://console.upstash.com)
# Get from: Redis dashboard → "REST API" section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lemon Squeezy (https://app.lemonsqueezy.com)
# Store ID: Settings → Store → Store ID
LEMONSQUEEZY_STORE_ID=

# Product ID: Product page → ID in URL
LEMONSQUEEZY_PRODUCT_ID=

# Variant IDs: comma-separated, from product variants page
# e.g. 123456,123457
LEMONSQUEEZY_VARIANT_IDS=

# Webhook secret: choose 6-40 character string, set in Dashboard → Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=

# Base URL (used in production)
# Vercel: leave empty, uses VERCEL_URL automatically
# Local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
